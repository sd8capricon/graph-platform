# External PostgreSQL database (shared by API, worker and schema-init).
PGHOST=your-postgres-host
PGPORT=5432
PGDATABASE=graph_platform
PGUSER=your-postgres-user
PGPASSWORD=replace-me

# Same database as PG* above, in Npgsql connection-string format.
API_PG_CONNECTION_STRING="Host=your-postgres-host;Port=5432;Database=graph_platform;Username=your-postgres-user;Password=replace-me;SSL Mode=Require;Trust Server Certificate=true"
JWT_SIGNING_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Use URI-safe alphanumeric values for the RabbitMQ credentials.
RABBITMQ_USER=graphplatform
RABBITMQ_PASSWORD=replaceWithRandomAlphanumericValue

# The origin from which a user's browser loads the frontend.
CORS_ALLOWED_ORIGIN=http://localhost:8080

# Provider secrets referenced by configs/local.yaml.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_API_KEY=

# Vite values are baked into the frontend image at build time.
VITE_APP_NAME=GraphForge
VITE_API_BASE_URL=http://localhost:5087
VITE_MAX_UPLOAD_BYTES=104857600
