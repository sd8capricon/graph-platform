# PostgreSQL 18 + Apache AGE + pgvector, provided by the Compose `postgres`
# service (docker/postgres/Dockerfile). Containers reach it at host "postgres";
# it is published on 127.0.0.1:${POSTGRES_HOST_PORT} for host-side tools
# (e.g. `dotnet ef database update`), which should connect via localhost.
PGHOST=postgres
PGPORT=5432
PGDATABASE=graph_platform
PGUSER=graphplatform
PGPASSWORD=replace-me
POSTGRES_HOST_PORT=5432

# Same database as PG* above, in Npgsql connection-string format. The host is the
# Compose service name; the host-side migration step overrides it to localhost.
API_PG_CONNECTION_STRING="Host=postgres;Port=5432;Database=graph_platform;Username=graphplatform;Password=replace-me"
JWT_SIGNING_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Use URI-safe alphanumeric values for the RabbitMQ credentials.
RABBITMQ_USER=graphplatform
RABBITMQ_PASSWORD=replaceWithRandomAlphanumericValue

# Secret Redis connection string. For local Compose, keep this URI; use the
# deployment's secret store for credentialed/TLS production Redis connections.
REDIS_CONNECTION_STRING=redis://redis:6379/0

# The origin from which a user's browser loads the frontend.
CORS_ALLOWED_ORIGIN=http://localhost:8080

# Provider secrets referenced by configs/local.yaml.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_API_KEY=

# Frontend runtime config (FRONTEND_*): rendered into /config.js at container
# start, so changing these needs only a container restart, not a rebuild.
FRONTEND_APP_NAME=GraphForge
FRONTEND_API_BASE_URL=http://localhost:5087
FRONTEND_MAX_UPLOAD_BYTES=104857600
# VITE_APP_NAME is build-time only: the static <title> fallback baked into index.html.
VITE_APP_NAME=GraphForge
