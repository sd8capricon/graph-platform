FROM python:3.14-slim AS runtime
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY src/common/ /app/src/common/
COPY src/agent-runtime/ /app/src/agent-runtime/
COPY configs/local.yaml /app/configs/local.yaml

WORKDIR /app/src/agent-runtime
RUN uv sync --locked --no-dev

ENV PATH="/app/src/agent-runtime/.venv/bin:$PATH" \
    PYTHONPATH=/app/src/agent-runtime/src:/app/src/common/src

WORKDIR /app
CMD ["agent-runtime"]
