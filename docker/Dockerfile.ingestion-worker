FROM python:3.14-slim AS runtime
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY src/common/ /app/src/common/
COPY src/ingestion-worker/ /app/src/ingestion-worker/
COPY configs/local.yaml /app/configs/local.yaml
COPY docker/init_python_schema.py /app/docker/init_python_schema.py

WORKDIR /app/src/ingestion-worker
RUN uv sync --locked --no-dev

ENV PATH="/app/src/ingestion-worker/.venv/bin:$PATH" \
    PYTHONPATH=/app/src/ingestion-worker/src:/app/src/common/src

CMD ["celery", "-A", "ingestion_worker.celery_app", "worker", "--loglevel=info"]
