FROM node:22-alpine AS build
WORKDIR /app

# Build-time only: the static <title> fallback in index.html. The API base URL
# and upload limit are runtime config (FRONTEND_*, rendered into /config.js by
# the entrypoint) and deliberately not build args.
ARG VITE_APP_NAME=GraphForge
ENV VITE_APP_NAME=${VITE_APP_NAME}

COPY src/frontend/package.json src/frontend/package-lock.json ./
RUN npm ci
COPY src/frontend/ ./
RUN npm run build

FROM nginx:alpine AS runtime
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY src/frontend/scripts/docker-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
COPY --from=build /app/dist/ /usr/share/nginx/html/
EXPOSE 80
ENTRYPOINT ["/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
