# Committed defaults. Vite only substitutes %VITE_*% in index.html for variables
# that are actually defined, so VITE_APP_NAME must live here, not only in the example.
VITE_APP_NAME=GraphForge
VITE_API_BASE_URL=http://localhost:5087
# Mirrors the API's FileUploads:MaxFileSizeBytes default (100 MiB).
VITE_MAX_UPLOAD_BYTES=104857600
